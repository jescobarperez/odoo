<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
      
       
        <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
             <xpath expr="//div[hasclass('page')]" position="inside">
               <style>
                .page {
                    margin: 0 !important;
                    padding: 0 !important;
                    font-size: 11pt;
                }
                .row {
                    margin: 0 !important;
                    padding: 0 !important;
                }
                .pt-5, .mt-5, .mb-5 {
                    padding-top: 0 !important;
                    margin-top: 0 !important;
                    margin-bottom: 0 !important;
                }
                .article {
                    margin-top: 0 !important;
                    padding-top: 0 !important;
                }
            </style>
                                
            </xpath>       
                  
            <xpath expr="//div[@id='informations']" position="before">
                <div class="row mt-1 mb-0 mw-100">  
                    <div class="col-6" name="informations_company">
                        <!-- Estilo para Datos de la Sociedad -->
                        <div class="d-flex align-items-center mb-2">
                            <strong class="col-6">Datos de la Sociedad:</strong>
                        </div>
                        <div class="d-flex align-items-baseline">
                            <strong class="col-4">Nombre:</strong>
                            <span class="col-8" t-esc="doc.company_id.partner_id.name"/>
                        </div>
                        <div class="d-flex align-items-baseline">
                            <strong class="col-4">Dirección:</strong>
                            <span class="col-8" t-esc="doc.company_id.partner_id.street"/>
                        </div>
                        <t t-if="doc.company_id.partner_id.vat">
                            <div class="d-flex align-items-baseline">
                                <strong class="col-4">NIT:</strong>
                                <span class="col-8" t-esc="doc.company_id.partner_id.vat"/>
                            </div>
                        </t>
                        <t t-if="doc.company_id.partner_id.commercial_registration_number">
                            <div class="d-flex align-items-baseline">
                                <strong class="col-4">IRCC:</strong>
                                <span class="col-8" t-esc="doc.company_id.partner_id.commercial_registration_number"/>
                            </div>
                        </t>
                        <t t-if="doc.company_id.partner_id.bank_accounts">
                            <div class="d-flex align-items-baseline">
                                <strong class="col-4">Cuenta bancaria:</strong>
                                <span class="col-8" t-esc="doc.company_id.partner_id.bank_accounts.split('; ')[0] or 'No especificado'"/>
                            </div>
                        </t>
                    </div>
            
                    <div class="col-6">
                        <!-- Estilo para Datos del Cliente -->
                        <div class="d-flex align-items-center mb-2">
                            <strong class="col-4">Datos del Cliente:</strong>
                        </div>
                        <div class="d-flex align-items-baseline">
                            <strong class="col-4">Nombre:</strong>
                            <span class="col-8" t-esc="doc.partner_id.name"/>
                        </div>
                        <div class="d-flex align-items-baseline">
                            <strong class="col-4">Dirección:</strong>
                            <span class="col-8">
                                <span t-esc="doc.partner_id.street"/>
                                <t t-if="doc.partner_id.state_id">, <span t-esc="doc.partner_id.state_id.name"/></t>
                            </span>
                        </div>
                        <t t-if="doc.partner_id.vat">
                            <div class="d-flex align-items-baseline">
                                <strong class="col-4">NIT:</strong>
                                <span class="col-8" t-esc="doc.partner_id.vat"/>
                            </div>
                        </t>
                        <t t-if="doc.partner_id.ref">
                            <div class="d-flex align-items-baseline">
                                <strong class="col-4">Código:</strong>
                                <span class="col-8" t-esc="doc.partner_id.ref"/>
                            </div>
                        </t>
                        <t t-if="doc.partner_id.bank_accounts">
                            <div class="d-flex align-items-baseline">
                                <strong class="col-4">Cuenta Bancaria:</strong>
                                <span class="col-8" t-esc="doc.partner_id.bank_accounts"/>
                            </div>
                        </t>
                        <t t-if="doc.partner_id.asi_contract">
                            <div class="d-flex align-items-baseline">
                                <strong class="col-4">Contrato:</strong>
                                <span class="col-8" t-esc="doc.partner_id.asi_contract"/>
                            </div>
                        </t>
                    </div>
                </div>
                <p></p>
            </xpath>
        
        
            <xpath expr="//h2[@class='mt-4']" position="attributes">
                <attribute name="class">mt-1</attribute>
            </xpath>
            <xpath expr="//div[@name='so_total_summary']" position="after">
                <div t-if="doc.payment_term_id" style="page-break-inside: avoid;">
                     <div t-if="doc.payment_term_id"><strong>Plazo de pago: </strong> <t t-esc="doc.payment_term_id.name or 'No especificado'"/></div>            
                 </div>                 
            </xpath> 
            
             <xpath expr="//p[@name='order_note']/parent::div" position="after">
                        
             </xpath>
          
        </template>
    </data>
</odoo>
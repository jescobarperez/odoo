<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    

    <template id="report_invoice_document_extend" inherit_id="account.report_invoice_document">
     <xpath expr="." position="inside">
          <style type="text/css">
            .mt-5 { margin-top: 0 !important; }
            .mb-5 { margin-bottom: 0 !important; }
          </style>
            <style>
                .signature-line div {
                    margin-top: 15px;
                    min-height: 20px;
                    border-bottom: 1px solid #000;
                    width: 100%;
                    padding: 0 5px;
                }
                
                .signature-section table {
                    width: 100%;
                    height: 180px;
                    margin-bottom: 20px;
                }
                
                .signature-section strong {
                    display: block;
                    margin-bottom: 10px;
                }
                
                .table-borderless td {
                    border: none !important;
                    vertical-align: bottom;
                }
            </style>

        </xpath>

        <xpath expr="//div[@name='shipping_address_block']/ancestor::div[contains(@class, 'row')]" position="replace">
            <!-- elimino el parrafo de las direcciones -->
            <t/>    
        </xpath>
        <xpath expr="//div[@id='informations']" position="before">      
            <div class="row mt-4 mb-4 mw-100">
                <!-- Columna izquierda: Datos básicos -->
                <div class="col-6">
                    <!-- Aplica el mismo estilo que "Fecha de factura" -->
                    <strong>Información del Cliente:</strong>
                    <div><strong>Nombre:</strong> <span t-esc="o.partner_id.name"/></div>
                    <div><strong>Dirección:</strong> <span t-esc="o.partner_id.contact_address"/></div>
                    <div t-if="o.partner_id.vat"><strong>NIT:</strong> <span t-esc="o.partner_id.vat"/></div>
                </div>

                <!-- Columna derecha: Código y cuentas bancarias -->
                <div class="col-6">
                    <!-- Aplica el mismo estilo que "Fecha de factura" -->
                    <p></p>
                    <div t-if="o.partner_id.ref">
                        <strong>Código:</strong> <span t-esc="o.partner_id.ref"/>
                    </div>
                    <div t-if="o.partner_id.bank_ids">
                        <strong>Cuenta Bancaria:</strong>
                        <ul class="list-unstyled">
                            <t t-foreach="o.partner_id.bank_ids" t-as="bank">
                                <li>
                                    <span t-esc="bank.bank_id.name"/>: 
                                    <span t-esc="bank.acc_number"/>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </xpath>
        
        <xpath expr="//div[hasclass('page')]" position="inside">
            <style>
                .page {
                    font-size: 12pt;
                }
            </style>
        </xpath>

        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">row</attribute>
        </xpath>
        <xpath expr="//p[@name='payment_communication']" position="replace">
            <p>
                <strong>Forma de Pago:</strong> <t t-esc="'Cheque o Transferencia'"/>.
                <strong> Plazo:</strong> <t t-esc="o.invoice_payment_term_id.name or 'No especificado'"/>.
                <strong> Páguese a cuenta bancaria:</strong> <t t-esc="o.company_id.partner_id.bank_ids[:1].acc_number or 'No especificado'"/>.                
                <strong> Importe en letras:</strong> <t t-esc="o.amount_in_words or 'No especificado'"/>.              
            </p>
        <!-- Agregar la tabla de firma antes del footer -->
        

            <!-- Sección de firmas modificada -->
       <!-- Sección de firmas con líneas fijas -->
    <div class="row mt-4 signature-section" style="page-break-inside: avoid;">
        
        <!-- Entregado por -->
        <div class="col-3">
            <table class="table table-sm table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <strong>ENTREGADO POR:</strong>
                            <div class="signature-line">
                                <div>Nombre: <t t-esc="o.invoice_user_id.employee_id.parent_id.name or ''"/></div>
                                <div>Firma:</div>
                                <div>Fecha:</div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Recibido por -->
        <div class="col-3">
            <table class="table table-sm table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <strong>RECIBIDO POR:</strong>
                            <div class="signature-line">
                                <div>Nombre:</div>
                                <div>Firma:</div>
                                <div>Fecha:</div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Transportado por 
        <div class="col-3">
            <table class="table table-sm table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <strong>TRANSPORTADO POR:</strong>
                            <div class="signature-line">
                                <div>Nombre:</div>
                                <div>Firma:</div>
                                <div>Fecha:</div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>-->

        <!-- Contabilizado por -->
        <div class="col-3">
            <table class="table table-sm table-borderless">
                <tbody>
                    <tr>
                        <td>
                            <strong>CONTABILIZADO POR:</strong>
                            <div class="signature-line">
                                <div>Nombre:</div>
                                <div>Firma:</div>
                                <div>Fecha:</div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

        </xpath>
    </template>
</odoo>
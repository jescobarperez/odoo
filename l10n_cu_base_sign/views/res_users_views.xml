<odoo>
    <record id="view_users_form_certificate" model="ir.ui.view">
        <field name="name">res.users.form.certificate</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Certificado Digital">
                    <group>
                        <field name="digital_certificate_p12" filename="certificate_filename"/>
                        <field name="certificate_filename" invisible="1"/>
                        <field name="digital_certificate_password" password="True"/>
                        <button name="action_test_p12" string="Validar Certificado" type="object" class="btn-primary"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

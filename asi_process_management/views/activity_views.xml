<odoo>
    <record id="view_x_activity_form" model="ir.ui.view">
        <field name="name">x.activity.form</field>
        <field name="model">x.activity</field>
        <field name="arch" type="xml">
            <form string="Actividad">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="process_id"/>
                        <field name="sequence"/>
                        <field name="duration"/>
                        <field name="frequency"/>
                        <field name="recurrence_type"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_x_activity_tree" model="ir.ui.view">
        <field name="name">x.activity.tree</field>
        <field name="model">x.activity</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="process_id"/>
                <field name="sequence"/>
                <field name="frequency"/>
                <field name="duration"/>
            </tree>
        </field>
    </record>

  <record id="action_activity" model="ir.actions.act_window">
    <field name="name">Actividades</field>
    <field name="res_model">x.activity</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>

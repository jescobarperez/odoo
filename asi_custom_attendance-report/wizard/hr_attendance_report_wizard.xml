<odoo>
    <record id="view_hr_attendance_report_wizard" model="ir.ui.view">
        <field name="name">hr.attendance.report.wizard</field>
        <field name="model">hr.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </group>
                <footer>
                    <button string="Print Report" type="object" name="print_report" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>